{
  "uid": "nova-overview",
  "title": "Nova — vue d'ensemble",
  "description": "État des écoles, versions, actifs face au palier, échéances.",
  "tags": [
    "nova"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "school",
        "label": "École",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nova-prometheus"
        },
        "query": "label_values(up, school)",
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Écoles qui envoient",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (school) (up == 1))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Actifs du mois, par école",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (school) (nova_active_users{period=\"month\",school=~\"$school\"})",
          "legendFormat": "{{school}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Jours avant l'échéance de licence",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (school) (nova_licence_days_left{school=~\"$school\"})",
          "legendFormat": "{{school}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Palier et état de licence",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nova_licence_info{school=~\"$school\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Versions installées",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (nova_app_versions{school=~\"$school\"})",
          "legendFormat": "{{version}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Serveur joignable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (school) (up{school=~\"$school\"})",
          "legendFormat": "{{school}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    }
  ]
}
