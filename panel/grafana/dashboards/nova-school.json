        "x": 6,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nova_members{school=~\"$school\",state=\"disabled\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
