      "targets": [
        {
          "refId": "A",
          "expr": "nova_uptime_seconds{school=~\"$school\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
