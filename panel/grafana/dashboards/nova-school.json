    {
      "id": 14,
      "title": "Erreurs serveur (1 h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (school) (increase(nova_http_errors_total{school=~\"$school\"}[1h]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ]
    },
