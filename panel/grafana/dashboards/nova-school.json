{
  "uid": "nova-school",
  "title": "Nova — fiche école",
  "description": "Tout sur une école : réglages, licence, comptes, versions, machine, moteurs, enveloppe IA, erreurs. Aucun nom d'élève.",
  "tags": [
    "nova"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "school",
        "label": "École",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nova-prometheus"
        },
        "query": "label_values(up, school)",
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Réglages du serveur",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nova_server_info{school=~\"$school\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Licence (palier, état)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nova_licence_info{school=~\"$school\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Jours avant l'échéance",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
