{
  "uid": "nova-optimisation",
  "title": "Nova — optimisation",
  "description": "Durée de chaque étape d'une dictée, médiane et 95e centile.",
  "tags": [
    "nova"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "school",
        "label": "École",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nova-prometheus"
        },
        "query": "label_values(up, school)",
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Médiane par étape",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(nova_stage_seconds_bucket{school=~\"$school\"}[5m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "95e centile par étape",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(nova_stage_seconds_bucket{school=~\"$school\"}[5m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "95e centile par école (transcription)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, school) (rate(nova_stage_seconds_bucket{stage=\"transcription\",school=~\"$school\"}[5m])))",
          "legendFormat": "{{school}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Latence HTTP, 95e centile",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nova-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(nova_http_latency_seconds_bucket{school=~\"$school\"}[5m])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nova-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
