# Local test configuration. Copy this file to .env before starting Docker.
NOVA_ADMIN_TOKEN=nova-admin-local
NOVA_TOKEN_TTL_SECONDS=2592000
NOVA_DOMAINS=eleves.ipsa.fr,ipsa.fr
NOVA_MAX_SEATS=300
NOVA_MAX_MACHINES=3
NOVA_REQUIRE_AUTH=true

NOVA_ORGANIZATION_ID=ipsa
NOVA_ORGANIZATION_NAME=IPSA
NOVA_ORGANIZATION_SHORT_NAME=IPSA
NOVA_ORGANIZATION_CAMPUS=Paris
NOVA_EDUCATION_MODE=normal
NOVA_AI_SKILLS_REQUIRED=false
NOVA_AI_SKILLS_TRACK_PROGRESS=true

# Microsoft Entra ID — public desktop application / Device Code flow.
NOVA_ENTRA_TENANT_ID=organizations
NOVA_ENTRA_CLIENT_ID=

# Leave empty locally: OTP codes are printed in `docker compose logs api`.
NOVA_SMTP_HOST=
NOVA_SMTP_PORT=587
NOVA_SMTP_USER=
NOVA_SMTP_PASS=
NOVA_SMTP_FROM=nova@ipsa.fr
