# Local test configuration. Copy this file to .env before starting Docker.
NOVA_TOKEN_TTL_SECONDS=2592000
NOVA_DOMAINS=eleves.ipsa.fr,ipsa.fr
NOVA_MAX_SEATS=300
NOVA_MAX_MACHINES=3
NOVA_REQUIRE_AUTH=true

NOVA_ORGANIZATION_ID=ipsa
NOVA_ORGANIZATION_NAME=IPSA
NOVA_ORGANIZATION_SHORT_NAME=IPSA
NOVA_ORGANIZATION_CAMPUS=Paris
NOVA_EDUCATION_MODE=normal
NOVA_AI_SKILLS_REQUIRED=false
NOVA_AI_SKILLS_TRACK_PROGRESS=true

# Microsoft Entra ID — public desktop application, no client secret ever.
# Shared by the legacy Device Code flow and the modern Authorization Code +
# PKCE flow.
NOVA_ENTRA_TENANT_ID=organizations
NOVA_ENTRA_CLIENT_ID=
# Directory (tenant) ID of the organization allowed to sign in. This is the
# explicit tenant -> organization mapping: an email domain never grants access.
# Leave empty and the modern SSO stays unavailable, on purpose.
NOVA_ENTRA_ALLOWED_TENANT_ID=

# Google Workspace — same engine, different constraints. Google issues a
# client secret for "Desktop app" clients and requires it at token exchange,
# while documenting that installed apps cannot keep secrets: it is a public
# identifier the protocol demands. It stays server-side because the server
# performs the exchange; Nova.exe never sees it.
NOVA_GOOGLE_CLIENT_ID=
NOVA_GOOGLE_CLIENT_SECRET=
# Hosted domain of the Workspace allowed to sign in. This is the explicit
# mapping: a personal @gmail.com account carries no `hd` and never gets in.
# Leave empty and Google stays unavailable, on purpose.
NOVA_GOOGLE_ALLOWED_HOSTED_DOMAIN=

# Generic OIDC — one configurable adapter for Okta, Keycloak, Auth0, Ping and
# any standard OpenID Connect provider. Endpoints are NOT configured by hand:
# they come from {issuer}/.well-known/openid-configuration.
NOVA_OIDC_ISSUER=
NOVA_OIDC_CLIENT_ID=
# Only if the IdP requires it. Server-side only: never reaches the desktop,
# /api/config, /api/me or the logs.
NOVA_OIDC_CLIENT_SECRET=
# none | client_secret_post | client_secret_basic
NOVA_OIDC_CLIENT_AUTH_METHOD=none
NOVA_OIDC_SCOPES=openid email profile
# Button label. Display only — "Continue with OIDC" means nothing to a user.
NOVA_OIDC_DISPLAY_NAME=
# A self-hosted Keycloak may legitimately live on a private network. This is an
# operator decision, never the desktop's: nothing in the API exposes it.
NOVA_OIDC_ALLOW_PRIVATE_ISSUER=false
# Optional exact-match constraint on one extra claim. No policy engine.
NOVA_OIDC_REQUIRED_CLAIM=
NOVA_OIDC_REQUIRED_CLAIM_VALUE=

# `production` (the default) refuses to print sign-in codes when SMTP is
# missing, so a misconfigured deployment fails loudly instead of leaking every
# user's code into its logs. Set `development` for the local stack below.
NOVA_ENV=development

# Leave empty locally: with NOVA_ENV=development, OTP codes are printed in
# `docker compose logs api`.
NOVA_SMTP_HOST=
NOVA_SMTP_PORT=587
NOVA_SMTP_USER=
NOVA_SMTP_PASS=
NOVA_SMTP_FROM=nova@ipsa.fr
