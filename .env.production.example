# Nova Organization — valeurs d'un deploiement de production.
#
# Copiez ce fichier en `.env` a cote de `docker-compose.production.yml`, puis
# remplissez-le. Les variables sans valeur ici sont celles qu'aucun defaut ne
# peut deviner : le demarrage s'arrete avec un message plutot que de choisir a
# votre place.
#
# Aucun secret ne s'ecrit dans ce fichier. Voir « Secrets » plus bas.

# --- Base et compteur partage ------------------------------------------------
# PostgreSQL 16, provisionne, sauvegarde et chiffre au repos par vos soins.
# L'URL est assemblee par la compose a partir de ces morceaux : le mot de passe
# n'apparait donc dans aucun fichier d'environnement. Il est lu dans le fichier
# de secret designe plus bas, et percent-encode par le serveur -- un « / » ou un
# « @ » dans un mot de passe ne peut pas tronquer l'adresse.
NOVA_DATABASE_USER=nova
NOVA_DATABASE_HOST=postgres.interne
NOVA_DATABASE_PORT=5432
NOVA_DATABASE_NAME=nova
# Facultatif, ajoute tel quel a la fin de l'URL. Par exemple `?sslmode=require`.
NOVA_DATABASE_QUERY=
# Redis est obligatoire. Sans compteur partage, chaque worker compte pour lui,
# et un quota de vingt par minute en vaut soixante avec trois workers.
NOVA_REDIS_URL=redis://redis.interne:6379/0

# --- Ce que le serveur annonce -----------------------------------------------
# Origines HTTPS, publiques. Ce sont des adresses annoncees, pas des adresses
# d'ecoute : l'API elle-meme n'ecoute que sur la boucle locale, derriere votre
# reverse proxy.
NOVA_ADMIN_ORIGINS=https://admin.exemple.fr
NOVA_SERVICE_ENDPOINT=https://nova.exemple.fr

# Domaines de messagerie dont les adresses peuvent se connecter, separes par
# des virgules. Sans eux, l'administrateur entre quand meme -- son compte
# existe deja -- et tous les autres membres sont refuses a la premiere
# connexion, sans que rien ne l'explique.
NOVA_DOMAINS=exemple.fr,cadres.exemple.fr

# --- Identite affichee sur les postes ----------------------------------------
NOVA_ORGANIZATION_ID=exemple
NOVA_ORGANIZATION_NAME=Etablissement Exemple
# Facultatifs. Le nom court derive du nom s'il est vide ; le campus n'a pas de
# defaut, parce qu'aucune valeur ne peut le deviner.
NOVA_ORGANIZATION_SHORT_NAME=
NOVA_ORGANIZATION_CAMPUS=
# `education` ou `business`.
NOVA_ORGANIZATION_TYPE=education

# --- Fournisseur d'identite --------------------------------------------------
# L'emetteur doit etre en HTTPS, sans exception. Un IdP auto-heberge sur un
# reseau prive est legitime, mais la contrainte de schema n'est pas relachee
# pour autant : il lui faut un certificat valide, portant son adresse, dont
# l'autorite est connue du serveur.
NOVA_OIDC_ISSUER=https://idp.exemple.fr/realms/nova
NOVA_OIDC_CLIENT_ID=nova
# `none` pour un client public avec PKCE, `client_secret_post` sinon.
NOVA_OIDC_CLIENT_AUTH_METHOD=none
NOVA_OIDC_DISPLAY_NAME=Compte Exemple

# --- Runtime d'inference prive -----------------------------------------------
# Vos services, sur votre reseau. Aucun modele par defaut : un deploiement qui
# n'en declare pas obtient `AI_MODEL_NOT_READY`, jamais un choix silencieux.
NOVA_WHISPER_URL=http://transcription.interne:8000
NOVA_WHISPER_MODEL=large-v3-turbo
NOVA_LLM_URL=http://texte.interne:8000/v1
NOVA_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
NOVA_AI_PROFILE=standard
# Combien de secondes une requete attend sa place avant d'etre refusee.
# Trop court, une personne qui dicte en meme temps qu'une autre se voit
# refusee alors qu'il restait du temps pour la servir ; son poste retombe
# alors sur son moteur local. Defaut 3 s, sous l'objectif de 5 s.
NOVA_AI_QUEUE_WAIT_SECONDS=8

# --- Reseau ------------------------------------------------------------------
# Adresses de vos reverse proxies. Vide par defaut : aucun proxy n'est cru tant
# qu'on ne l'a pas declare, et `X-Forwarded-For` est alors ignore.
NOVA_TRUSTED_PROXIES=10.0.0.4

# --- Courrier ----------------------------------------------------------------
NOVA_SMTP_HOST=smtp.exemple.fr
NOVA_SMTP_PORT=587
NOVA_SMTP_USER=nova@exemple.fr
NOVA_SMTP_FROM=nova@exemple.fr

# --- Secrets -----------------------------------------------------------------
# Une *reference*, jamais une valeur. Le serveur accepte `file:///chemin` et
# `env://NOM`, et refuse au demarrage un secret faible, trop court ou laisse par
# defaut. Un fichier de secret doit etre en chemin absolu, UTF-8, de taille
# bornee, et non lisible par tout le monde.
#
# `NOVA_SECRETS_DIR` designe le dossier de l'hote monte en lecture seule sur
# `/run/secrets` dans les conteneurs.
NOVA_SECRETS_DIR=./secrets
# Le mot de passe PostgreSQL : un fichier, pas une valeur. Chemin tel que le
# conteneur le voit.
NOVA_DATABASE_PASSWORD_FILE=/run/secrets/db_password
NOVA_OIDC_CLIENT_SECRET=file:///run/secrets/oidc_client_secret
NOVA_SMTP_PASS=file:///run/secrets/smtp_password
# Fourni apres enrolement depuis Nova Admin, et seulement si vous faites tourner
# le Connector (`--profile connector`).
NOVA_CONNECTOR_CREDENTIAL=file:///run/secrets/connector_credential
